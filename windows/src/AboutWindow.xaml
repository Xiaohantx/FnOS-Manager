<Window x:Class="FnOSManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 FnOS Manager" Height="395" Width="385"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Border Background="#12151E" CornerRadius="16" BorderBrush="#252B3B" BorderThickness="1" Margin="5">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Brand & Version -->
                <RowDefinition Height="*" />    <!-- Features List -->
                <RowDefinition Height="Auto" /> <!-- External Links -->
                <RowDefinition Height="Auto" /> <!-- Copyright -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#3B82F6" />
                    <TextBlock Text="关于 FnOS Manager" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" Width="24" Height="24" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>

            <!-- 2. Brand & Version -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border Width="52" Height="52" CornerRadius="12" Margin="0,0,0,8" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/AppLogo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="FnOS Manager" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="飞牛私有云 (fnOS) Windows 原生桌面管理器" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,3,0,6" />
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#203B82F6" BorderBrush="#403B82F6" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="Version 1.0.3 · Windows" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#38BDF8" />
                    </Border>
                    <Border x:Name="CheckUpdateBorder" Background="#1A2234" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="8,3" Cursor="Hand" MouseLeftButtonUp="CheckUpdate_Click">
                        <TextBlock x:Name="UpdateBtnText" Text="检查更新" FontSize="9.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- 3. System & Spec Card -->
            <Border Grid.Row="2" Background="#161A26" BorderBrush="#262D3D" BorderThickness="1" CornerRadius="10" Padding="12,5" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="11" Foreground="#60A5FA" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="虚拟化内核" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Windows Hyper-V (原生)" FontSize="11" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Separator Background="#222838" Margin="0,1" />
                    <Grid Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📼" FontSize="11" Foreground="#34D399" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="动态内存调度" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Dynamic Memory 动态回收" FontSize="11" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Separator Background="#222838" Margin="0,1" />
                    <Grid Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="11" Foreground="#A78BFA" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="控制台直达" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="http://nas.fnos ↗" FontSize="10.5" FontFamily="Consolas" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="ConsoleUrl_Click" />
                    </Grid>
                    <Separator Background="#222838" Margin="0,1" />
                    <Grid Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="11" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="虚拟磁盘模式" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="动态扩展 VHDX" FontSize="11" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. External Links -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="飞牛官网 (fnnas.com) ↗" Grid.Column="0" Background="#1E293B" Foreground="#38BDF8" BorderThickness="1" BorderBrush="#334155" Padding="0,7" Margin="0,0,5,0" Cursor="Hand" Click="VisitOfficial_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="项目仓库 (GitHub) ↗" Grid.Column="1" Background="#1E293B" Foreground="#E2E8F0" BorderThickness="1" BorderBrush="#334155" Padding="0,7" Margin="5,0,0,0" Cursor="Hand" Click="VisitGitHub_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 5. Copyright -->
            <TextBlock Grid.Row="4" Text="声明：底层系统与固件产权归属飞牛官方 (fnnas.com) 所有" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center" />
        </Grid>
    </Border>
</Window>
