<Window x:Class="FnOSManager.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FnOS 运行日志" Height="420" Width="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="#12151E" CornerRadius="16" BorderBrush="#252B3B" BorderThickness="1" Margin="5">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📜" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="FnOS 运行日志" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" Width="24" Height="24" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>

            <!-- Log List -->
            <Border Grid.Row="1" Background="#0A0C12" CornerRadius="10" BorderBrush="#1E2330" BorderThickness="1" Padding="8">
                <ListBox x:Name="LogsList" Background="Transparent" BorderThickness="0" Foreground="#D1D5DB" FontFamily="Consolas" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Timestamp}" Foreground="#6B7280" Margin="0,0,8,0" />
                                <Border Background="#1E293B" CornerRadius="4" Padding="4,1" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Tag}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" />
                                </Border>
                                <TextBlock Text="{Binding Message}" Foreground="#F3F4F6" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Button Content="复制全部" HorizontalAlignment="Left" Background="#262D3D" Foreground="White" BorderThickness="0" Padding="12,5" Cursor="Hand" Click="Copy_Click" />
                <Button Content="关闭" HorizontalAlignment="Right" Background="#3B82F6" Foreground="White" BorderThickness="0" Padding="16,5" Cursor="Hand" Click="Close_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
